{
  "name": "Hushlist — Universal Wishlist",
  "short_name": "Hushlist",
  "description": "Every wish, any store — zero spoilers, zero duplicate gifts, zero exposed home addresses.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "/api/image-proxy?label=Hushlist&theme=indigo",
      "sizes": "400x280",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
